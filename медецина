        "from enum import Enum\n",
        "from datetime import datetime\n",
        "from typing import Optional\n",
        "\n",
        "\n",
        "class AppointmentStatus(Enum):\n",
        "    \"\"\"Статусы записи на приём\"\"\"\n",
        "    SCHEDULED = \"Запланирован\"\n",
        "    COMPLETED = \"Завершён\"\n",
        "    CANCELLED = \"Отменён\"\n",
        "\n",
        "\n",
        "class Appointment:\n",
        "    \"\"\"Класс, представляющий запись на приём\"\"\"\n",
        "\n",
        "    _next_id = 1\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        patient_id: int,\n",
        "        doctor_id: int,\n",
        "        appointment_time: datetime\n",
        "    ):\n",
        "        self.id = Appointment._next_id\n",
        "        Appointment._next_id += 1\n",
        "        self.patient_id = patient_id\n",
        "        self.doctor_id = doctor_id\n",
        "        self.appointment_time = appointment_time\n",
        "        self.status = AppointmentStatus.SCHEDULED\n",
        "\n",
        "    def cancel(self) -> None:\n",
        "        \"\"\"Отмена записи\"\"\"\n",
        "        self.status = AppointmentStatus.CANCELLED\n",
        "\n",
        "    def complete(self) -> None:\n",
        "        \"\"\"Завершение приёма\"\"\"\n",
        "        self.status = AppointmentStatus.COMPLETED\n",
        "\n",
        "    def __str__(self) -> str:\n",
        "        time_str = self.appointment_time.strftime(\"%d.%m.%Y %H:%M\")\n",
        "        return f\"Запись #{self.id}: пациент {self.patient_id}, доктор {self.doctor_id}, {time_str} [{self.status.value}]\"\n",
        "\n",
        "    def __repr__(self) -> str:\n",
        "        return self.__str__()"
      ]
