        "\n",
        "    def __str__(self) -> str:\n",
        "        return f\"[{self.id}] {self.name}, Тел: {self.phone}\"\n",
        "\n",
        "    def __repr__(self) -> str:\n",
        "        return self.__str__()\n",
        "\n",
        "\n",
        "class Appointment:\n",
        "    \"\"\"Класс, представляющий запись на приём\"\"\"\n",
        "\n",
        "    _next_id = 1\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
