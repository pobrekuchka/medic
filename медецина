        "import re\n",
        "\n",
        "\n",
        "# ==================== МОДЕЛИ ДАННЫХ ====================\n",
        "\n",
        "class AppointmentStatus(Enum):\n",
        "    \"\"\"Статусы записи на приём\"\"\"\n",
        "    SCHEDULED = \"Запланирован\"\n",
        "    COMPLETED = \"Завершён\"\n",
        "    CANCELLED = \"Отменён\"\n",
        "\n",
        "\n",
        "class Doctor:\n",
        "    \"\"\"Класс, представляющий врача\"\"\"\n",
        "\n",
        "    _next_id = 1\n",
        "\n",
        "    def __init__(self, name: str, specialization: str, cabinet_number: int):\n",
        "        self.id = Doctor._next_id\n",
        "        Doctor._next_id += 1\n",
        "        self.name = name\n",
        "        self.specialization = specialization\n",
        "        self.cabinet_number = cabinet_number\n",
        "\n",
        "    def __str__(self) -> str:\n",
        "        return f\"[{self.id}] {self.name} ({self.specialization}), Кабинет: {self.cabinet_number}\"\n",
        "\n",
        "    def __repr__(self) -> str:\n",
        "        return self.__str__()\n",
        "\n",
        "\n",
        "class Patient:\n",
        "    \"\"\"Класс, представляющий пациента\"\"\"\n",
        "\n",
        "    _next_id = 1\n",
        "\n",
        "    def __init__(self, name: str, phone: str):\n",
        "        self.id = Patient._next_id\n",
        "        Patient._next_id += 1\n",
        "        self.name = name\n",
        "        self.phone = phone\n",
        "\n",
        "    def __str__(self) -> str:\n",
        "        return f\"[{self.id}] {self.name}, Тел: {self.phone}\"\n",
        "\n",
        "    def __repr__(self) -> str:\n",
        "        return self.__str__()\n",
        "\n",
        "\n",
        "class Appointment:\n",
        "    \"\"\"Класс, представляющий запись на приём\"\"\"\n",
        "\n",
        "    _next_id = 1\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        patient_id: int,\n",
        "        doctor_id: int,\n",
        "        appointment_time: datetime\n",
        "    ):\n",
        "        self.id = Appointment._next_id\n",
        "        Appointment._next_id += 1\n",
        "        self.patient_id = patient_id\n",
        "        self.doctor_id = doctor_id\n",
        "        self.appointment_time = appointment_time\n",
        "        self.status = AppointmentStatus.SCHEDULED\n",
        "\n",
        "    def cancel(self) -> None:\n",
        "        \"\"\"Отмена записи\"\"\"\n",
        "        self.status = AppointmentStatus.CANCELLED\n",
        "\n",
        "    def complete(self) -> None:\n",
        "        \"\"\"Завершение приёма\"\"\"\n",
        "        self.status = AppointmentStatus.COMPLETED\n",
        "\n",
        "    def __str__(self) -> str:\n",
        "        time_str = self.appointment_time.strftime(\"%d.%m.%Y %H:%M\")\n",
        "        return f\"Запись #{self.id}: пациент {self.patient_id}, доктор {self.doctor_id}, {time_str} [{self.status.value}]\"\n",
        "\n",
        "    def __repr__(self) -> str:\n",
        "        return self.__str__()\n",
        "\n",
        "\n",
        "# ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ ПРОВЕРОК ====================\n",
        "\n",
        "def validate_name(name: str) -> tuple[bool, str]:\n",
        "    \"\"\"\n",
        "    Проверка ФИО на наличие только букв, пробелов и дефисов\n",
        "    Возвращает (True, \"\") если имя корректно, (False, сообщение_об_ошибке) если содержит цифры или спецсимволы\n",
        "    \"\"\"\n",
        "    if not name or len(name.strip()) == 0:\n",
        "        return False, \"ФИО не может быть пустым\"\n",
        "\n",
        "    # Проверяем, что в строке есть хотя бы одна буква\n",
        "    if not re.search(r'[а-яА-Яa-zA-Z]', name):\n",
        "        return False, \"ФИО должно содержать хотя бы одну букву\"\n",
        "\n",
        "    # Проверяем, что в строке нет цифр\n",
        "    if re.search(r'\\d', name):\n",
        "        return False, \"ФИО не должно содержать цифр\"\n",
        "\n",
        "    # Проверяем, что строка состоит только из допустимых символов (буквы, пробелы, дефисы, точки)\n",
        "    if not re.match(r'^[а-яА-Яa-zA-Z\\s\\-\\.]+$', name):\n",
        "        return False, \"ФИО может содержать только буквы, пробелы, дефисы и точки\"\n",
        "\n",
        "    return True, \"\"\n",
        "\n",
        "\n",
        "def validate_phone(phone: str) -> tuple[bool, str]:\n",
        "    \"\"\"Проверка номера телефона\"\"\"\n",
        "    if not phone or len(phone.strip()) == 0:\n",
        "        return False, \"Телефон не может быть пустым\"\n",
        "\n",
        "    # Очищаем номер от лишних символов для проверки\n",
        "    cleaned = re.sub(r'[\\s\\-\\(\\)\\+]', '', phone)\n",
        "\n",
        "    # Проверяем, что номер состоит только из цифр\n",
        "    if not cleaned.isdigit():\n",
        "        return False, \"Телефон должен содержать только цифры и символы +, -, (, )\"\n",
        "\n",
        "    # Проверяем минимальную длину\n",
        "    if len(cleaned) < 10:\n",
        "        return False, \"Телефон должен содержать минимум 10 цифр\"\n",
        "\n",
        "    return True, \"\"\n",
        "\n",
        "\n",
        "def validate_specialization(specialization: str) -> tuple[bool, str]:\n",
        "    \"\"\"Проверка специализации\"\"\"\n",
        "    if not specialization or len(specialization.strip()) == 0:\n",
        "        return False, \"Специализация не может быть пустой\"\n",
        "\n",
        "    # Специализация может содержать буквы, пробелы, дефисы\n",
        "    if not re.match(r'^[а-яА-Яa-zA-Z\\s\\-]+$', specialization):\n",
        "        return False, \"Специализация может содержать только буквы, пробелы и дефисы\"\n",
        "\n",
        "    return True, \"\"\n",
        "\n",
        "\n",
        "def validate_cabinet_number(cabinet: int) -> tuple[bool, str]:\n",
