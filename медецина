        "# ==================== УПРАВЛЯЮЩИЙ КЛАСС ====================\n",
        "\n",
        "class Clinic:\n",
        "    \"\"\"Класс клиники/регистратуры. Централизованно управляет всеми операциями\"\"\"\n",
        "\n",
        "    def __init__(self, name: str = \"Городская поликлиника\"):\n",
        "        self.name = name\n",
        "        self._doctors: Dict[int, Doctor] = {}\n",
        "        self._patients: Dict[int, Patient] = {}\n",
        "        self._appointments: Dict[int, Appointment] = {}\n",
        "\n",
        "        # Для быстрого поиска занятых слотов: ключ = (doctor_id, datetime)\n",
        "        self._occupied_slots: Dict[Tuple[int, datetime], int] = {}\n",
        "\n",
        "    # ==================== Управление врачами ====================\n",
        "\n",
        "    def add_doctor(self, name: str, specialization: str, cabinet_number: int) -> Optional[Doctor]:\n",
        "        \"\"\"Добавление нового врача\"\"\"\n",
        "        doctor = Doctor(name, specialization, cabinet_number)\n",
        "        self._doctors[doctor.id] = doctor\n",
        "        print(f\"✓ Врач добавлен: {doctor}\")\n",
        "        return doctor\n",
        "\n",
        "    def get_doctor(self, doctor_id: int) -> Optional[Doctor]:\n",
        "        \"\"\"Поиск врача по ID\"\"\"\n",
        "        return self._doctors.get(doctor_id)\n",
        "\n",
        "    def find_doctors_by_specialization(self, specialization: str) -> List[Doctor]:\n",
        "        \"\"\"Поиск врачей по специальности\"\"\"\n",
        "        return [d for d in self._doctors.values()\n",
        "                if specialization.lower() in d.specialization.lower()]\n",
        "\n",
        "    def find_doctors_by_name(self, name: str) -> List[Doctor]:\n",
        "        \"\"\"Поиск врачей по имени\"\"\"\n",
        "        return [d for d in self._doctors.values()\n",
        "                if name.lower() in d.name.lower()]\n",
        "\n",
        "    def list_all_doctors(self) -> List[Doctor]:\n",
        "        \"\"\"Список всех врачей\"\"\"\n",
        "        return list(self._doctors.values())\n",
        "\n",
        "    # ==================== Управление пациентами ====================\n",
        "\n",
        "    def register_patient(self, name: str, phone: str) -> Optional[Patient]:\n",
        "        \"\"\"Регистрация нового пациента\"\"\"\n",
        "        patient = Patient(name, phone)\n",
        "        self._patients[patient.id] = patient\n",
        "        print(f\"✓ Пациент зарегистрирован: {patient}\")\n",
        "        return patient\n",
        "\n",
        "    def get_patient(self, patient_id: int) -> Optional[Patient]:\n",
        "        \"\"\"Поиск пациента по ID\"\"\"\n",
        "        return self._patients.get(patient_id)\n",
        "\n",
        "    def find_patients_by_name(self, name: str) -> List[Patient]:\n",
        "        \"\"\"Поиск пациентов по имени\"\"\"\n",
        "        return [p for p in self._patients.values()\n",
        "                if name.lower() in p.name.lower()]\n",
        "\n",
        "    def list_all_patients(self) -> List[Patient]:\n",
        "        \"\"\"Список всех пациентов\"\"\"\n",
        "        return list(self._patients.values())\n",
        "\n",
        "    # ==================== Создание записи ====================\n",
        "\n",
        "    def _is_slot_available(self, doctor_id: int, appointment_time: datetime) -> bool:\n",
        "        \"\"\"Проверка, свободен ли слот у врача\"\"\"\n",
        "        # Нельзя записывать на прошедшее время\n",
        "        if appointment_time < datetime.now():\n",
        "            return False\n",
        "        return (doctor_id, appointment_time) not in self._occupied_slots\n",
        "\n",
        "    def _check_patient_conflict(self, patient_id: int, appointment_time: datetime) -> bool:\n",
        "        \"\"\"Проверка, нет ли у пациента другой активной записи на это же время\"\"\"\n",
        "        for app in self._appointments.values():\n",
        "            if (app.patient_id == patient_id and\n",
        "                app.status == AppointmentStatus.SCHEDULED and\n",
        "                app.appointment_time == appointment_time):\n",
        "                return False  # Есть конфликт\n",
        "        return True  # Конфликта нет\n",
        "\n",
        "    def create_appointment(\n",
        "        self,\n",
        "        patient_id: int,\n",
        "        doctor_id: int,\n",
        "        appointment_time: datetime\n",
        "    ) -> Optional[Appointment]:\n",
        "        \"\"\"\n",
        "        Создание записи на приём\n",
        "        Возвращает созданную запись или None при ошибке\n",
        "        \"\"\"\n",
        "        # Проверка существования врача и пациента\n",
        "        doctor = self.get_doctor(doctor_id)\n",
        "        patient = self.get_patient(patient_id)\n",
        "\n",
        "        if not doctor:\n",
        "            print(\"✗ Ошибка: Врач не найден\")\n",
        "            return None\n",
        "\n",
        "        if not patient:\n",
        "            print(\"✗ Ошибка: Пациент не найден\")\n",
        "            return None\n",
        "\n",
        "        # Проверка, что время не прошедшее\n",
        "        if appointment_time < datetime.now():\n",
        "            print(\"✗ Ошибка: Нельзя записываться на прошедшее время\")\n",
        "            return None\n",
        "\n",
        "        # Проверка занятости слота\n",
        "        if not self._is_slot_available(doctor_id, appointment_time):\n",
        "            print(f\"✗ Ошибка: Время {appointment_time.strftime('%d.%m.%Y %H:%M')} уже занято у врача {doctor.name}\")\n",
        "            return None\n",
        "\n",
        "        # Проверка, что у пациента нет другой записи на это же время\n",
        "        if not self._check_patient_conflict(patient_id, appointment_time):\n",
        "            print(f\"✗ Ошибка: У пациента {patient.name} уже есть активная запись на это время\")\n",
        "            return None\n",
        "\n",
        "        # Создание записи\n",
        "        appointment = Appointment(patient_id, doctor_id, appointment_time)\n",
        "        self._appointments[appointment.id] = appointment\n",
        "        self._occupied_slots[(doctor_id, appointment_time)] = appointment.id\n",
        "\n",
        "        print(f\"✓ Запись создана: {appointment}\")\n",
        "        return appointment\n",
        "\n",
        "    # ==================== Отмена и перенос ====================\n",
        "\n",
        "    def cancel_appointment(self, appointment_id: int) -> bool:\n",
        "        \"\"\"Отмена записи\"\"\"\n",
        "        appointment = self._appointments.get(appointment_id)\n",
        "\n",
        "        if not appointment:\n",
        "            print(\"✗ Ошибка: Запись не найдена\")\n",
        "            return False\n",
        "\n",
        "        if appointment.status != AppointmentStatus.SCHEDULED:\n",
        "            print(f\"✗ Ошибка: Запись уже {appointment.status.value}\")\n",
        "            return False\n",
        "\n",
        "        # Освобождаем слот\n",
        "        key = (appointment.doctor_id, appointment.appointment_time)\n",
        "        if key in self._occupied_slots:\n",
        "            del self._occupied_slots[key]\n",
        "\n",
        "        # Меняем статус\n",
        "        appointment.cancel()\n",
        "        print(f\"✓ Запись #{appointment_id} отменена\")\n",
        "        return True\n",
        "\n",
        "    def reschedule_appointment(\n",
        "        self,\n",
        "        appointment_id: int,\n",
        "        new_time: datetime\n",
        "    ) -> Optional[Appointment]:\n",
        "        \"\"\"\n",
        "        Перенос записи на новое время\n",
        "        Возвращает обновлённую запись или None при ошибке\n",
        "        \"\"\"\n",
        "        appointment = self._appointments.get(appointment_id)\n",
        "\n",
        "        if not appointment:\n",
        "            print(\"✗ Ошибка: Запись не найдена\")\n",
        "            return None\n",
        "\n",
        "        if appointment.status != AppointmentStatus.SCHEDULED:\n",
        "            print(f\"✗ Ошибка: Нельзя перенести запись со статусом {appointment.status.value}\")\n",
        "            return None\n",
        "\n",
        "        # Проверка нового слота\n",
        "        if not self._is_slot_available(appointment.doctor_id, new_time):\n",
        "            print(f\"✗ Ошибка: Новое время {new_time.strftime('%d.%m.%Y %H:%M')} уже занято\")\n",
        "            return None\n",
        "\n",
        "        # Проверка конфликта у пациента\n",
        "        if not self._check_patient_conflict(appointment.patient_id, new_time):\n",
        "            patient = self.get_patient(appointment.patient_id)\n",
        "            print(f\"✗ Ошибка: У пациента {patient.name} уже есть запись на это время\")\n",
        "            return None\n",
        "\n",
        "        # Освобождаем старый слот\n",
        "        old_key = (appointment.doctor_id, appointment.appointment_time)\n",
        "        if old_key in self._occupied_slots:\n",
        "            del self._occupied_slots[old_key]\n",
        "\n",
        "        # Обновляем время\n",
        "        old_time = appointment.appointment_time\n",
        "        appointment.appointment_time = new_time\n",
        "\n",
        "        # Занимаем новый слот\n",
        "        self._occupied_slots[(appointment.doctor_id, new_time)] = appointment.id\n",
        "\n",
        "        print(f\"✓ Запись #{appointment_id} перенесена с {old_time.strftime('%d.%m.%Y %H:%M')} на {new_time.strftime('%d.%m.%Y %H:%M')}\")\n",
        "        return appointment\n",
        "\n",
        "    # ==================== Просмотр расписания и поиск ====================\n",
        "\n",
        "    def get_doctor_schedule(self, doctor_id: int, date: datetime) -> List[Appointment]:\n",
        "        \"\"\"Просмотр расписания врача на конкретную дату\"\"\"\n",
        "        doctor = self.get_doctor(doctor_id)\n",
        "        if not doctor:\n",
        "            print(\"✗ Врач не найден\")\n",
        "            return []\n",
        "\n",
        "        result = []\n",
        "        for app in self._appointments.values():\n",
        "            if (app.doctor_id == doctor_id and\n",
        "                app.appointment_time.date() == date.date() and\n",
        "                app.status == AppointmentStatus.SCHEDULED):\n",
        "                result.append(app)\n",
        "\n",
        "        return sorted(result, key=lambda x: x.appointment_time)\n",
        "\n",
        "    def get_patient_appointments(self, patient_id: int, active_only: bool = True) -> List[Appointment]:\n",
        "        \"\"\"Получение записей пациента\"\"\"\n",
        "        result = []\n",
        "        for app in self._appointments.values():\n",
        "            if app.patient_id == patient_id:\n",
        "                if active_only and app.status != AppointmentStatus.SCHEDULED:\n",
        "                    continue\n",
        "                result.append(app)\n",
        "\n",
        "        return sorted(result, key=lambda x: x.appointment_time)\n",
        "\n",
        "    def get_appointments_by_date(self, date: datetime) -> List[Appointment]:\n",
        "        \"\"\"Все записи на конкретную дату\"\"\"\n",
        "        result = []\n",
        "        for app in self._appointments.values():\n",
        "            if app.appointment_time.date() == date.date() and app.status == AppointmentStatus.SCHEDULED:\n",
        "                result.append(app)\n",
        "\n",
        "        return sorted(result, key=lambda x: x.appointment_time)\n",
        "\n",
        "    def get_available_slots(self, doctor_id: int, date: datetime) -> List[datetime]:\n",
        "        \"\"\"\n",
        "        Получение свободных слотов врача на день\n",
        "        (для демонстрации создаём слоты с 9:00 до 18:00, каждый час)\n",
        "        \"\"\"\n",
        "        doctor = self.get_doctor(doctor_id)\n",
        "        if not doctor:\n",
        "            return []\n",
        "\n",
        "        available = []\n",
        "        for hour in range(9, 18):  # 9:00 - 17:00\n",
        "            slot_time = datetime(date.year, date.month, date.day, hour, 0)\n",
        "            if slot_time > datetime.now() and self._is_slot_available(doctor_id, slot_time):\n",
        "                available.append(slot_time)\n",
        "\n",
        "        return available\n",
        "\n",
        "\n",
        "# ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ ВВОДА/ВЫВОДА ====================\n",
        "\n",
        "def parse_datetime(date_str: str, time_str: str) -> Optional[datetime]:\n",
        "    \"\"\"Парсинг даты и времени из строк\"\"\"\n",
        "    try:\n",
        "        return datetime.strptime(f\"{date_str} {time_str}\", \"%d.%m.%Y %H:%M\")\n",
        "    except ValueError:\n",
        "        return None\n",
        "\n",
        "\n",
        "def format_datetime(dt: datetime) -> str:\n",
        "    \"\"\"Форматирование даты и времени\"\"\"\n",
        "    return dt.strftime(\"%d.%m.%Y %H:%M\")\n",
        "\n",
